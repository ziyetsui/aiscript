{
  "name": "@scripter/desktop",
  "productName": "Ancher Scripter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "e2e": "electron-vite build && node e2e/app.e2e.ts"
  },
  "dependencies": {
    "@ancher-ai/sdk": "0.4.0",
    "@scripter/agent": "workspace:*",
    "@scripter/core": "workspace:*",
    "@scripter/license": "workspace:*",
    "loro-crdt": "1.16.4",
    "node-machine-id": "1.1.12",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright-core": "1.64.0",
    "vite": "7.3.7"
  }
}
